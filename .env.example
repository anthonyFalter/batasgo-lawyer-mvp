# Add local environment variables here. Do not commit secrets.
DATABASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-20b.
GROQ_MODEL=

# Clerk publishable key is intended for browser use; keep the secret key server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gemini API key from https://aistudio.google.com/apikey
# Used by the BatasBot /api/chat route (server-side only — never exposed to the browser)
GEMINI_API_KEY=
