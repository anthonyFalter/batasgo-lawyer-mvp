# Add local environment variables here. Do not commit secrets.
DATABASE_URL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash.
GEMINI_MODEL=
GROQ_API_KEY=

# Optional overrides for AI model selection
# Intake summary route (defaults to openai/gpt-oss-20b)
GROQ_MODEL=
# BatasBot chat route (defaults to openai/gpt-oss-20b)
GROQ_CHAT_MODEL=

# Clerk publishable key is intended for browser use; keep the secret key server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Citizen Clerk instance's JWT public key (PEM), used to verify citizen bearer tokens.
CITIZEN_CLERK_JWT_KEY=
# Comma-separated exact origins of the citizen app; production origins must use HTTPS.
# Local development may use http://localhost:3000.
CITIZEN_APP_ORIGINS=
